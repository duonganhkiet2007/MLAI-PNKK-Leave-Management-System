# ============================================================
# .env.example — The Escalation Referee (MLAI)
# Copy file này thành `.env` rồi chỉnh sửa theo môi trường của bạn.
# Biến nào không khai báo sẽ dùng giá trị mặc định trong code.
# ============================================================

# ---- Ollama / VLM -------------------------------------------
# Tên model Vision-Language trên Ollama. Cần pull trước: ollama pull <tên>
VLM_TARGET_MODEL=qwen2.5vl:7b

# URL của Ollama server. Mặc định local là http://localhost:11434.
# Trong docker-compose (service backend) giá trị này được fix thành http://ollama:11434.
OLLAMA_BASE=http://localhost:11434

# Giới hạn chiều dài/lớn nhất của ảnh gửi cho VLM (pixel). Giảm nếu hết VRAM.
VLM_MAX_IMAGE_DIM=1600

# Thời gian giữ model trên GPU sau mỗi lần gọi (-1 = không bao giờ gỡ).
OLLAMA_KEEP_ALIVE=-1

# Timeout (giây) khi gọi VLM. Tăng nếu ảnh lớn / GPU chậm.
VLM_TIMEOUT_SEC=180

# Tự nạp VLM vào GPU ngay khi backend khởi động (1 = bật, 0 = tắt).
VLM_WARMUP_ON_STARTUP=1

# ---- Backend -------------------------------------------------
# Cổng Web API (cũng phục vụ giao diện tại /).
PORT=8000

# Các origin được phép gọi API (CORS), phân cách bằng dấu phẩy.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Dữ liệu runtime -----------------------------------------
# Chỉ dùng khi chạy local (không Docker). Trong Docker, 2 biến dưới đây
# được mount vào volume app_data tại /data.
LEAVE_DB_PATH=backend/data/leave_app.db
LEAVE_UPLOAD_DIR=backend/data/uploads
