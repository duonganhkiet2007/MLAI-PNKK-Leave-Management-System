# ============================================================
# .gitignore — MLAI / The Escalation Referee (Hackathon 2026)
# ============================================================

# ------ Python cache ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ------ SQLite database (runtime data, không commit) --------
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# ------ Log files -------------------------------------------
*.log

# ------ Environment / secrets --------------------------------
.env
.env.*
*.env
!.env.example

# ------ Môi trường ảo / conda (nếu lỡ tạo trong project) ---
venv/
.venv/
env/
.conda/
test_env/
**/test_env/

# ------ IDE / Editor -----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------ HuggingFace model cache (weights rất nặng) ----------
.cache/
huggingface/
*.safetensors
*.bin
*.pt
*.ckpt

# ------ OS artifacts -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------ Build / dist -----------------------------------------
dist/
build/
*.egg-info/

# ------ Runtime Data (DB, uploads, logs) --------------------
backend/data/

# ------ AI tools / Agent runtime ----------------------------
.agents/
.codex/
.local/
.nfs*
**/.nfs*

# ------ Pytest / test cache ---------------------------------
.pytest_cache/
**/.pytest_cache/

# ------ VLM inference cache ---------------------------------
backend/uploads/vlm_cache/

# ------ Benchmark run results (timestamped) -----------------
benchmarks/results/20*/
evaluation/benchmarks/results/20*/

# ------ Docs (tài liệu tham khảo, không cần commit) ---------
docs/

